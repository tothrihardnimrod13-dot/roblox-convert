 cash</string></Properties></Item><Item class="Folder" referent="RBXTRAFFIC_REQUESTED_9079"><Properties><string name="Name">Traffic</string></Properties></Item></Item><Item class="Folder" referent="RBXPAID_Cash1000"><Properties><string name="Name">Cash1000</string></Properties><Item class="StringValue" referent="RBXPAID_ProductType1871737502729105491_FIX6"><Properties><string name="Name">ProductType</string><string name="Value">DeveloperProduct</string></Properties></Item><Item class="IntValue" referent="RBXPAID_PriceRobux7427142257213845270_FIX6"><Properties><string name="Name">PriceRobux</string><int name="Value">500</int></Properties></Item><Item class="IntValue" referent="RBXPAID_ProductId2922444414237037373_FIX6"><Properties><string name="Name">ProductId</string><int name="Value">0</int></Properties></Item><Item class="StringValue" referent="RBXPAID_Description3246364677779695526_FIX6"><Properties><string name="Name">Description</string><string name="Value">Add $1000 cash</string></Properties></Item><Item class="Folder" referent="RBXTRAFFIC_REQUESTED_9084"><Properties><string name="Name">Traffic</string></Properties></Item></Item><Item class="Folder" referent="RBXTRAFFIC_REQUESTED_9053"><Properties><string name="Name">Traffic</string></Properties></Item></Item><Item class="Folder" referent="RBXTRAFFIC_REQUESTED_9052"><Properties><string name="Name">Traffic</string></Properties></Item></Item></Item>
  <Item class="ServerScriptService" referent="RBX00000003">
    <Properties><string name="Name">ServerScriptService</string></Properties>
    <Item class="Script" referent="RBX00004153">
      <Properties>
        <string name="Name">CityGameServer</string><bool name="Disabled">true</bool>
        <ProtectedString name="Source">
local Players=game:GetService("Players")
local Teams=game:GetService("Teams")
local RS=game:GetService("ReplicatedStorage")
local Lighting=game:GetService("Lighting")
local state=RS:WaitForChild("GameState")
local lobby=workspace.Spawns.LobbySpawn
local city=workspace.Spawns.CitySpawn
local prison=workspace.Spawns.PrisonSpawn

local function tp(p,sp)
    if p.Character then p.Character:PivotTo(sp.CFrame+Vector3.new(0,5,0)) end
end
local function setup(p)
    p.Team=Teams.Lobby
    p:SetAttribute("Money",100); p:SetAttribute("Hunger",100)
    p:SetAttribute("InPrison",false); p:SetAttribute("Thefts",0)
    p.CharacterAdded:Connect(function()
        task.wait(.4)
        if p:GetAttribute("InPrison") then p.Team=Teams.Prison; tp(p,prison)
        elseif p.Team==Teams.Lobby then tp(p,lobby)
        else tp(p,city) end
    end)
end
Players.PlayerAdded:Connect(setup)
for _,p in ipairs(Players:GetPlayers()) do setup(p) end

-- Touch the black truck to launch the whole lobby group into the city.
local truck=workspace.Lobby.BlackTruck
for _,d in ipairs(truck:GetDescendants()) do
    if d:IsA("BasePart") then
        d.Touched:Connect(function(hit)
            local p=Players:GetPlayerFromCharacter(hit.Parent)
            if not p or p.Team~=Teams.Lobby then return end
            for _,q in ipairs(Players:GetPlayers()) do
                if q.Team==Teams.Lobby then q.Team=Teams.City; q:SetAttribute("Hunger",100); tp(q,city) end
            end
        end)
    end
end

-- 2:30 day / 2:30 night.
task.spawn(function()
    local night=false; local t=150
    while true do
        state.SecondsLeft.Value=t; state.IsNight.Value=night and 1 or 0
        Lighting.ClockTime=night and 0 or 12
        Lighting.FogEnd=night and 650 or 1200
        task.wait(1); t-=1
        if t&lt;0 then night=not night; if not night then state.DayNumber.Value+=1 end; t=150 end
    end
end)

-- Hunger drains with movement; at zero, HP loss.
task.spawn(function()
    while true do
        task.wait(1)
        for _,p in ipairs(Players:GetPlayers()) do
            if p.Team==Teams.City then
                local c=p.Character; local h=p:GetAttribute("Hunger") or 0
                local hum=c and c:FindFirstChildOfClass("Humanoid")
                local root=c and c:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health&gt;0 then
                    if root.AssemblyLinearVelocity.Magnitude&gt;2 then h=math.max(0,h-1); p:SetAttribute("Hunger",h) end
                    if h&lt;=0 then hum:TakeDamage(5) end
                end
            end
        end
    end
end)

-- Prison rescue.
workspace.Prison.RescuePoint.RescuePrompt.Triggered:Connect(function(rescuer)
    if rescuer.Team~=Teams.City then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p:GetAttribute("InPrison") then
            p:SetAttribute("InPrison",false); p.Team=Teams.City; tp(p,city); break
        end
    end
end)

-- Entering the prison compound captures a city player.
workspace.Prison.PrisonGround.Touched:Connect(function(hit)
    local p=Players:GetPlayerFromCharacter(hit.Parent)
    if p and p.Team==Teams.City and hit.Parent:FindFirstChild("HumanoidRootPart") then
        if (hit.Parent.HumanoidRootPart.Position-workspace.Prison.PrisonGround.Position).Magnitude&lt;120 then
            p:SetAttribute("InPrison",true); p.Team=Teams.Prison; tp(p,prison)
        end
    end
end)

-- Garage door contact recovers the corresponding car.
for _,g in ipairs(workspace.City.HiddenGarages:GetChildren()) do
    local idx=g:FindFirstChild("CarIndex")
    local door=g:FindFirstChild("Door")
    if idx and door then
        door.Touched:Connect(function(hit)
            local p=Players:GetPlayerFromCharacter(hit.Parent)
            if not p or p.Team~=Teams.City then return end
            local car=workspace.City.Vehicles:FindFirstChild("SportsCar_"..idx.Value)
            if car and not car:GetAttribute("Recovered") then
                car:SetAttribute("Recovered",true); state.CarsRecovered.Value+=1
                car:PivotTo(workspace.City.Vehicles:FindFirstChild("SportsCar_1").PrimaryPart and car:GetPivot() or car:GetPivot())
            end
        end)
    end
end
