    <Item class="LocalScript" referent="RBXVIS_288303080"><Properties><string name="Name">VisualPolishClient</string><ProtectedString name="Source">local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer

local function animateGui()
    local gui = player:WaitForChild("PlayerGui"):WaitForChild("CityHUD", 10)
    if not gui then return end
    local frame = gui:FindFirstChildWhichIsA("Frame")
    if not frame then return end

    frame.BackgroundTransparency = 0.28
    frame.AnchorPoint = Vector2.new(0.5,0)
    frame.Position = UDim2.new(0.5,0,0.035,0)
    frame.Size = UDim2.new(0.82,0,0.17,0)

    local stroke = frame:FindFirstChild("VisualStroke") or Instance.new("UIStroke")
    stroke.Name = "VisualStroke"
    stroke.Thickness = 1.5
    stroke.Transparency = 0.25
    stroke.Parent = frame

    local corner = frame:FindFirstChild("VisualCorner") or Instance.new("UICorner")
    corner.Name = "VisualCorner"
    corner.CornerRadius = UDim.new(0,12)
    corner.Parent = frame

    task.spawn(function()
        while frame.Parent do
            local t = TweenService:Create(frame, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true), {
                BackgroundTransparency = 0.20
            })
            t:Play()
            t.Completed:Wait()
        end
    end)
end

task.spawn(animateGui)
</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="LocalScript" referent="V7_1000000000002"><Properties><string name="Name">CityLifeHUDClient</string><bool name="Disabled">true</bool><ProtectedString name="Source">local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local Lighting=game:GetService("Lighting")
local player=Players.LocalPlayer
local state=ReplicatedStorage:WaitForChild("CityLifeState")

local gui=Instance.new("ScreenGui")
gui.Name="CityLifeHUD"; gui.ResetOnSpawn=false; gui.Parent=player:WaitForChild("PlayerGui")
local label=Instance.new("TextLabel")
label.Name="CityStatus"; label.AnchorPoint=Vector2.new(0.5,0); label.Position=UDim2.fromScale(0.5,0.025); label.Size=UDim2.fromOffset(330,36)
label.BackgroundTransparency=0.25; label.BackgroundColor3=Color3.fromRGB(10,14,20); label.TextColor3=Color3.fromRGB(225,240,255)
label.Font=Enum.Font.GothamMedium; label.TextSize=15; label.Text="CITY"; label.Parent=gui
local corner=Instance.new("UICorner"); corner.CornerRadius=UDim.new(0,10); corner.Parent=label

local function formatTime(sec)
 local mins=math.floor(sec/60); local s=math.floor(sec%60)
 return string.format("%02d:%02d",mins,s)
end
local lastWeather=""
state:GetAttributeChangedSignal("Clock"):Connect(function()
 local clock=state:GetAttribute("Clock") or 0
 local day=state:GetAttribute("Day") or 1
 local phase=state:GetAttribute("Phase") or "Day"
 local weather=state:GetAttribute("Weather") or "Clear"
 label.Text=string.format("DAY %d  •  %s  •  %s  •  %s",day,formatTime(clock),phase,weather)
 if weather~=lastWeather then
  lastWeather=weather
  label.Size=UDim2.fromOffset(350,36)
  TweenService:Create(label,TweenInfo.new(.25,Enum.EasingStyle.Quad),{Size=UDim2.fromOffset(330,36)}):Play()
 end
end)

-- Subtle local atmosphere pulse, keeping the city visually alive without expensive per-frame effects.
task.spawn(function()
 while true do
  task.wait(3)
  local weather=state:GetAttribute("Weather")
  if weather=="Storm" then
   local old=Lighting.Brightness
   Lighting.Brightness=math.max(0.7,old-0.2)
   task.wait(.15)
   Lighting.Brightness=old
  end
 end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBXV8CLIENT"><Properties><string name="Name">CityAmbienceClient</string><ProtectedString name="Source">local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Lighting=game:GetService("Lighting")
local RunService=game:GetService("RunService")
local state=ReplicatedStorage:WaitForChild("CityLifeState")
local last=nil
local function apply()
    local w=state:GetAttribute("Weather") or "Clear"
    if w==last then return end
    last=w
    if w=="Clear" then Lighting.ExposureCompensation=0
    elseif w=="Fog" then Lighting.ExposureCompensation=-0.15
    elseif w=="Rain" then Lighting.ExposureCompensation=-0.25
    else Lighting.ExposureCompensation=-0.45 end
end
RunService.RenderStepped:Connect(apply)</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="LocalScript" referent="RBXNEW_CITY_HUD_900002"><Properties><string name="Name">CityHUD</string><ProtectedString name="Source">
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local player=Players.LocalPlayer
local state=ReplicatedStorage:WaitForChild("CityGameState")
local event=ReplicatedStorage:WaitForChild("CityGameEvent")

local gui=Instance.new("ScreenGui")
gui.Name="CityHUD"; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=false; gui.Parent=player:WaitForChild("PlayerGui")

local function label(name,size,pos,text)
    local l=Instance.new("TextLabel"); l.Name=name; l.Size=size; l.Position=pos
    l.BackgroundTransparency=0.22; l.BackgroundColor3=Color3.fromRGB(12,16,22)
    l.TextColor3=Color3.fromRGB(245,248,255); l.Font=Enum.Font.GothamBold; l.TextScaled=true
    l.Text=text; l.Parent=gui
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,10); c.Parent=l
    return l
end
local top=label("Top",UDim2.new(0.72,0,0,44),UDim2.new(0.02,0,0.02,0),"99 NIGHTS IN THE CITY")
local stats=label("Stats",UDim2.new(0.48,0,0,40),UDim2.new(0.02,0,0.085,0),"♥ 100   🍗 100   $100")
local obj=label("Objective",UDim2.new(0.94,0,0,54),UDim2.new(0.03,0,0.87,0),"Join a truck to begin")
obj.TextWrapped=true
local note=label("Notice",UDim2.new(0.72,0,0,70),UDim2.new(0.14,0,0.18,0),"")
note.Visible=false
local function setState()
    local ph=state.Phase.Value
    local sec=state.Seconds.Value
    local n=state.Night.Value
    local w=state.Weather.Value
    local mins=math.floor(sec/60); local s=sec%60
    top.Text=string.format("99 NIGHTS IN THE CITY   •   NIGHT %d   •   %02d:%02d   •   %s   •   %s",n,mins,s,ph,w)
    local h=player:GetAttribute("Hunger") or 100
    local cars=player:GetAttribute("CarsFound") or 0
    stats.Text=string.format("♥ 100   🍗 %d   $%d   🚗 %d/4",math.floor(h),player:GetAttribute("Money") or 100,cars)
    obj.Text=state.Objective.Value
end
for _,v in ipairs({state.Phase,state.Seconds,state.Night,state.Weather,state.Objective}) do v.Changed:Connect(setState) end
player:GetAttributeChangedSignal("Hunger"):Connect(setState)
player:GetAttributeChangedSignal("CarsFound"):Connect(setState)
player:GetAttributeChangedSignal("Money"):Connect(setState)
event.OnClientEvent:Connect(function(kind,title,text)
    if kind=="Notify" then
        note.Text=title.."\n"..text; note.Visible=true
        task.delay(4,function() if note then note.Visible=false end end)
    end
end)
setState()
