    <Item class="Script" referent="RBX00004155">
      <Properties>
        <string name="Name">NightPursuerService</string><bool name="Disabled">true</bool>
        <ProtectedString name="Source">
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local active={}
local function spawnPursuer(pos)
    local m=Instance.new("Model"); m.Name="NightPursuer"; m.Parent=workspace.City.NPCs
    local r=Instance.new("Part"); r.Name="HumanoidRootPart"; r.Size=Vector3.new(2,2,1); r.Position=pos; r.Color=Color3.fromRGB(55,60,70); r.Parent=m
    local h=Instance.new("Humanoid"); h.MaxHealth=100; h.Health=100; h.WalkSpeed=17; h.Parent=m
    local head=Instance.new("Part"); head.Name="Head"; head.Size=Vector3.new(2,1.5,2); head.Position=pos+Vector3.new(0,2,0); head.Parent=m
    local w=Instance.new("WeldConstraint"); w.Part0=r; w.Part1=head; w.Parent=r
    m.PrimaryPart=r; table.insert(active,m)
end
task.spawn(function()
    while true do
        task.wait(15)
        if RS.GameState.IsNight.Value==1 then
            for i=1,math.random(2,5) do spawnPursuer(Vector3.new(math.random(-900,900),5,math.random(-900,900))) end
        end
    end
end)
task.spawn(function()
    while true do
        task.wait(.5)
        for _,n in ipairs(active) do
            if n.Parent and n.PrimaryPart then
                local best,dist=nil,80
                for _,p in ipairs(Players:GetPlayers()) do
                    local c=p.Character
                    if p.Team==game.Teams.City and c and c:FindFirstChild("HumanoidRootPart") then
                        local d=(c.HumanoidRootPart.Position-n.PrimaryPart.Position).Magnitude
                        if d&lt;dist then best=p;dist=d end
                    end
                end
                if best then
                    n:MoveTo(best.Character.HumanoidRootPart.Position)
                    if dist&lt;4 then
                        local h=best.Character:FindFirstChildOfClass("Humanoid")
                        if h then h:TakeDamage(8) end
                    end
                end
            end
        end
    end
end)
