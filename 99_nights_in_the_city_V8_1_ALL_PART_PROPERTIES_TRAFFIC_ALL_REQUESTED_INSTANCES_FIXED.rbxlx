  <Item class="Script" referent="RBXVIS_483945712"><Properties><string name="Name">CityVisuals</string><ProtectedString name="Source">local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local state = RS:WaitForChild("GameState")
local city = workspace:WaitForChild("City")
local streetFolder = city:FindFirstChild("StreetLights")
local buildings = city:FindFirstChild("Buildings")
local shops = city:FindFirstChild("Shops")
local garages = city:FindFirstChild("HiddenGarages")

-- Cinematic lighting, created at runtime so it survives place publishing cleanly.
local atmosphere = Lighting:FindFirstChild("CityAtmosphere") or Instance.new("Atmosphere")
atmosphere.Name = "CityAtmosphere"
atmosphere.Density = 0.28
atmosphere.Offset = 0.12
atmosphere.Color = Color3.fromRGB(190,205,225)
atmosphere.Decay = Color3.fromRGB(80,90,110)
atmosphere.Glare = 0.08
atmosphere.Haze = 1.25
atmosphere.Parent = Lighting

local bloom = Lighting:FindFirstChild("CityBloom") or Instance.new("BloomEffect")
bloom.Name = "CityBloom"
bloom.Intensity = 0.18
bloom.Size = 24
bloom.Threshold = 1.1
bloom.Parent = Lighting

local cc = Lighting:FindFirstChild("CityColorGrade") or Instance.new("ColorCorrectionEffect")
cc.Name = "CityColorGrade"
cc.Brightness = 0.02
cc.Contrast = 0.08
cc.Saturation = 0.05
cc.TintColor = Color3.fromRGB(245,248,255)
cc.Parent = Lighting

local rays = Lighting:FindFirstChild("CitySunRays") or Instance.new("SunRaysEffect")
rays.Name = "CitySunRays"
rays.Intensity = 0.035
rays.Spread = 0.65
rays.Parent = Lighting

Lighting.GlobalShadows = true
Lighting.EnvironmentDiffuseScale = 0.55
Lighting.EnvironmentSpecularScale = 0.7
Lighting.Brightness = 2.2

-- Smooth out the blockout materials. These are native Roblox materials, so there
-- are no broken external texture IDs. High-detail PBR can be added later to meshes.
local function polishPart(p)
    if not p:IsA("BasePart") then return end
    p.CastShadow = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth

    local n = string.lower(p.Name)
    local c = p.Color

    if n:find("window") or n:find("glass") then
        p.Material = Enum.Material.Glass
        p.Reflectance = 0.08
    elseif n:find("road") or n:find("asphalt") then
        p.Material = Enum.Material.Concrete
        p.Reflectance = 0
    elseif n:find("metal") or n:find("rail") then
        p.Material = Enum.Material.Metal
        p.Reflectance = 0.18
    elseif n:find("sign") or n:find("neon") then
        p.Material = Enum.Material.Neon
        p.Reflectance = 0
    elseif c.R &lt; 0.18 and c.G &lt; 0.20 and c.B &lt; 0.22 then
        p.Material = Enum.Material.SmoothPlastic
        p.Reflectance = 0.04
    elseif c.R &gt; 0.55 and c.G &gt; 0.55 and c.B &gt; 0.55 then
        p.Material = Enum.Material.Concrete
        p.Reflectance = 0.02
    else
        p.Material = Enum.Material.SmoothPlastic
        p.Reflectance = 0.02
    end
end

for _, d in ipairs(city:GetDescendants()) do
    if d:IsA("BasePart") then
        polishPart(d)
    end
end

-- Street lights: warm pools of light and subtle flicker at night.
local lights = {}
if streetFolder then
    for _, d in ipairs(streetFolder:GetDescendants()) do
        if d:IsA("BasePart") and d.Size.Y &lt;= 4 then
            local light = d:FindFirstChild("CityLamp")
            if not light then
                light = Instance.new("PointLight")
                light.Name = "CityLamp"
                light.Color = Color3.fromRGB(255, 221, 170)
                light.Brightness = 1.8
                light.Range = 24
                light.Shadows = true
                light.Parent = d
            end
            table.insert(lights, light)
        end
    end
end

-- A limited number of emissive windows makes the city feel alive without spawning
-- thousands of Parts.
local windowParts = {}
if buildings then
    local count = 0
    for _, model in ipairs(buildings:GetChildren()) do
        if model:IsA("Model") and count &lt; 120 then
            local cf, size = model:GetBoundingBox()
            if size.X &gt; 18 and size.Z &gt; 18 and size.Y &gt; 12 then
                for side = 1,2 do
                    for row = 1,2 do
                        if count &gt;= 120 then break end
                        local x = cf.Position.X + (side == 1 and size.X/2 + 0.08 or -size.X/2 - 0.08)
                        local y = cf.Position.Y + size.Y * (0.42 + row*0.16)
                        local z = cf.Position.Z
                        local w = math.min(7, size.Z*0.16)
                        local win = Instance.new("Part")
                        win.Name = "CityWindowGlow"
                        win.Anchored = true
                        win.CanCollide = false
                        win.CanTouch = false
                        win.CanQuery = false
                        win.Material = Enum.Material.Neon
                        win.Color = Color3.fromRGB(255, 214, 126)
                        win.Transparency = 1
                        win.Size = Vector3.new(0.12, math.min(3.5,size.Y*0.08), w)
                        win.CFrame = CFrame.new(x,y,z) * CFrame.Angles(0,0,0)
                        win.Parent = city
                        table.insert(windowParts, win)
                        count += 1
                    end
                end
            end
        end
    end
end

-- Shops get a gentle emissive sign pulse.
local shopSigns = {}
if shops then
    for _, shop in ipairs(shops:GetChildren()) do
        local base = shop:FindFirstChild("Store")
        if base and base:IsA("BasePart") then
            base.Material = Enum.Material.Neon
            table.insert(shopSigns, base)
        end
    end
end

-- Garage doors now animate open when the corresponding sports car is recovered.
local garageConnections = {}
if garages then
    for _, garage in ipairs(garages:GetChildren()) do
        local door = garage:FindFirstChild("Door")
        local idx = garage:FindFirstChild("CarIndex")
        if door and door:IsA("BasePart") and idx then
            local closed = door.CFrame
            garageConnections[garage] = {door=door, closed=closed}
            garage:GetAttributeChangedSignal("Recovered"):Connect(function()
                if garage:GetAttribute("Recovered") then
                    TweenService:Create(door, TweenInfo.new(1.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        CFrame = closed * CFrame.new(0, 9, 0),
                        Transparency = 0.35
                    }):Play()
                end
            end)
        end
    end
end

local night = false
local function setNight(on)
    night = on
    local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    local goal = on and {
        Brightness = 1.0,
        ClockTime = 0.0,
        FogEnd = 700,
        ExposureCompensation = -0.25
    } or {
        Brightness = 2.3,
        ClockTime = 12.0,
        FogEnd = 1500,
        ExposureCompensation = 0.05
    }
    TweenService:Create(Lighting, info, goal):Play()
    TweenService:Create(atmosphere, info, {
        Density = on and 0.38 or 0.25,
        Haze = on and 1.7 or 1.0
    }):Play()
    TweenService:Create(cc, info, {
        Saturation = on and -0.02 or 0.08,
        Contrast = on and 0.13 or 0.08
    }):Play()
    for _, light in ipairs(lights) do
        light.Enabled = on
    end
    for _, w in ipairs(windowParts) do
        w.Transparency = on and 0.08 or 1
    end
end

state.IsNight.Changed:Connect(function(v)
    setNight(v == 1)
end)
setNight(state.IsNight.Value == 1)

-- Animated ambience.
task.spawn(function()
    while true do
        task.wait(math.random(0.8, 2.2))
        if night then
            for i=1,math.min(4,#lights) do
                local light = lights[math.random(1,#lights)]
                light.Enabled = false
                task.wait(math.random(4,12)/100)
                light.Enabled = true
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.08)
        local pulse = 0.65 + math.sin(os.clock()*2.2)*0.35
        for _, sign in ipairs(shopSigns) do
            if sign.Parent then
                sign.Transparency = 0.04
                sign.Reflectance = 0.05 + pulse*0.05
            end
        end
        bloom.Intensity = 0.14 + pulse*0.07
    end
end)
</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="Script" referent="V7_1000000000001"><Properties><string name="Name">CityLifeServer</string><bool name="Disabled">true</bool><ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local ReplicatedStorage=game:GetService("ReplicatedStorage")

local city=workspace:FindFirstChild("City")
local traffic=city and city:FindFirstChild("V6_Traffic")
local people=city and city:FindFirstChild("V6_Pedestrians")
local garages=city and city:FindFirstChild("HiddenGarages")
local shops=city and city:FindFirstChild("Shops")
local parks=city and city:FindFirstChild("Parks")

local state=ReplicatedStorage:FindFirstChild("CityLifeState")
if not state then
    state=Instance.new("Folder")
    state.Name="CityLifeState"
    state.Parent=ReplicatedStorage
end

local DAY_LENGTH=300
local DAY_SECONDS=150
local rng=Random.new()

state:SetAttribute("Clock",0)
state:SetAttribute("Day",1)
state:SetAttribute("Phase","Day")
state:SetAttribute("Weather","Clear")
state:SetAttribute("CityMood","Calm")
state:SetAttribute("GarageSeed",rng:NextInteger(1,1000000000))

local clock=0
local day=1
local carAgents={}
local pedAgents={}
local streetLights={}
local trafficLights={}
local shopStates={}
local windowLights={}
local fountainParts={}

-- Four garages are randomized on every new server.
local garageSpots={
    Vector3.new(-920,2,-760),Vector3.new(-620,2,-760),Vector3.new(-320,2,-760),
    Vector3.new(120,2,-760),Vector3.new(480,2,-760),Vector3.new(820,2,-760),
    Vector3.new(-920,2,-350),Vector3.new(-520,2,-350),Vector3.new(-80,2,-350),
    Vector3.new(420,2,-350),Vector3.new(820,2,-350),
    Vector3.new(-920,2,120),Vector3.new(-480,2,120),Vector3.new(-40,2,120),
    Vector3.new(420,2,120),Vector3.new(820,2,120),
    Vector3.new(-920,2,560),Vector3.new(-520,2,560),Vector3.new(-80,2,560),
    Vector3.new(420,2,560),Vector3.new(820,2,560),
    Vector3.new(-760,2,900),Vector3.new(-300,2,900),Vector3.new(220,2,900),
    Vector3.new(700,2,900)
}

local function shuffle(t)
    for i=#t,2,-1 do
        local j=rng:NextInteger(1,i)
        t[i],t[j]=t[j],t[i]
    end
end

if garages then
    local gs={}
    for _,g in ipairs(garages:GetChildren()) do
        if g:IsA("Model") and g.Name:match("^Garage%d$") then table.insert(gs,g) end
    end
    table.sort(gs,function(a,b) return a.Name&lt;b.Name end)
    local spots={}
    for i,v in ipairs(garageSpots) do spots[i]=v end
    shuffle(spots)
    for i,g in ipairs(gs) do
        local p=spots[i]
        g:PivotTo(CFrame.new(p)*CFrame.Angles(0,math.rad(rng:NextInteger(0,3)*90),0))
        g:SetAttribute("RandomizedThisRun",true)
        g:SetAttribute("GarageIndex",i)
    end
end

local function partsOf(m)
    local t={}
    for _,d in ipairs(m:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(t,d) end
    end
    return t
end

if traffic then
    for _,m in ipairs(traffic:GetChildren()) do
        if m:IsA("Model") then
            local p=m:GetPivot().Position
            local axis=(math.abs(m:GetExtentsSize().X)&gt;=math.abs(m:GetExtentsSize().Z)) and "X" or "Z"
            table.insert(carAgents,{model=m,axis=axis,speed=rng:NextNumber(7,14),dir=(rng:NextInteger(0,1)==0 and -1 or 1)})
            for _,part in ipairs(partsOf(m)) do part.CanCollide=false end
        end
    end
end

if people then
    for _,m in ipairs(people:GetChildren()) do
        if m:IsA("Model") then
            local p=m:GetPivot().Position
            table.insert(pedAgents,{model=m,target=p,speed=rng:NextNumber(1.5,3.0)})
            for _,part in ipairs(partsOf(m)) do part.CanCollide=false end
        end
    end
end

local function choosePedTarget(a)
    local p=a.model:GetPivot().Position
    local r=420
    a.target=Vector3.new(
        math.clamp(p.X+rng:NextNumber(-r,r),-1080,1080),
        p.Y,
        math.clamp(p.Z+rng:NextNumber(-r,r),-1080,1080)
    )
end
for _,a in ipairs(pedAgents) do choosePedTarget(a) end

if city then
    local sl=city:FindFirstChild("StreetLights")
    if sl then
        for _,d in ipairs(sl:GetDescendants()) do
            if d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                table.insert(streetLights,d)
            end
        end
    end
    for _,d in ipairs(city:GetDescendants()) do
        if d:IsA("Model") and d.Name:lower():find("traffic") and d.Name~="V6_Traffic" then
            table.insert(trafficLights,d)
        elseif d:IsA("PointLight") and d.Name:lower():find("window") then
            table.insert(windowLights,d)
        end
    end
end

if shops then
    for _,shop in ipairs(shops:GetChildren()) do
        if shop:IsA("Model") then shopStates[shop]=true end
    end
end

if parks then
    for _,d in ipairs(parks:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("fountain") then
            table.insert(fountainParts,d)
        end
    end
end

local function updateStreetLights(night)
    for _,l in ipairs(streetLights) do
        l.Enabled=night
        if night then l.Brightness=2 end
    end
end

local function updateShops(night)
    for shop,_ in pairs(shopStates) do
        local open=not night
        shop:SetAttribute("Open",open)
        for _,d in ipairs(shop:GetDescendants()) do
            if d:IsA("BasePart") and d.Name=="Door" then
                d.CanCollide=night
            end
        end
    end
end

local function updateWindows(night)
    for _,l in ipairs(windowLights) do
        l.Enabled=night and rng:NextNumber()&lt;0.72
        if night then l.Brightness=1.2 end
    end
end

local function updateWeather()
    local roll=rng:NextNumber()
    local w=(roll&lt;0.58 and "Clear") or (roll&lt;0.76 and "Fog") or (roll&lt;0.93 and "Rain") or "Storm"
    state:SetAttribute("Weather",w)
    state:SetAttribute("CityMood",w=="Clear" and "Calm" or "Restless")
    if w=="Fog" then
        Lighting.FogStart=60; Lighting.FogEnd=620
    elseif w=="Rain" then
        Lighting.FogStart=90; Lighting.FogEnd=900
    elseif w=="Storm" then
        Lighting.FogStart=40; Lighting.FogEnd=500
    else
        Lighting.FogStart=180; Lighting.FogEnd=1800
    end
end

local function stormFlash()
    if state:GetAttribute("Weather")~="Storm" then return end
    local old=Lighting.Brightness
    Lighting.Brightness=4
    task.wait(0.10)
    Lighting.Brightness=old
end

local function setClockLighting(c)
    local night=c&gt;=DAY_SECONDS
    if not night then
        Lighting.ClockTime=6.5+(c/DAY_SECONDS)*11.5
    else
        local ct=18+((c-DAY_SECONDS)/DAY_SECONDS)*6
        Lighting.ClockTime=(ct&gt;=24) and (ct-24) or ct
    end
    state:SetAttribute("Phase",night and "Night" or "Day")
    updateStreetLights(night)
    updateShops(night)
    updateWindows(night)
end

task.spawn(function()
    while true do
        task.wait(rng:NextNumber(18,32))
        updateWeather()
        if state:GetAttribute("Weather")=="Storm" then task.spawn(stormFlash) end
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        local oldPhase=state:GetAttribute("Phase")
        clock+=1
        if clock&gt;=DAY_LENGTH then
            clock=0
            day+=1
            state:SetAttribute("Day",day)
        end
        state:SetAttribute("Clock",clock)
        setClockLighting(clock)
        local phase=state:GetAttribute("Phase")
        if oldPhase=="Day" and phase=="Night" then updateWeather() end

        -- 1:10 into the night, the normal city activity briefly goes quiet.
        if phase=="Night" and clock==DAY_SECONDS+70 then
            state:SetAttribute("CityMood","Quiet")
            task.delay(10,function()
                if state:GetAttribute("Weather")~="Storm" then
                    state:SetAttribute("CityMood","Restless")
                end
            end)
        end
    end
end)

local function moveCar(a,dt)
    local p=a.model:GetPivot().Position
    local d=(a.axis=="X" and Vector3.new(a.dir,0,0) or Vector3.new(0,0,a.dir))*a.speed*dt
    local np=p+d
    if math.abs(np.X)&gt;1120 then np=Vector3.new(-np.X,np.Y,np.Z) end
    if math.abs(np.Z)&gt;1120 then np=Vector3.new(np.X,np.Y,-np.Z) end
    local look=(a.axis=="X" and Vector3.new(a.dir,0,0) or Vector3.new(0,0,a.dir))
    a.model:PivotTo(CFrame.lookAt(np,np+look))
end

local pedTick=0
local signalTick=0
local fountainTick=0

RunService.Heartbeat:Connect(function(dt)
    for _,a in ipairs(carAgents) do moveCar(a,dt) end

    pedTick+=dt
    if pedTick&gt;=0.1 then
        pedTick=0
        for _,a in ipairs(pedAgents) do
            local p=a.model:GetPivot().Position
            local delta=Vector3.new(a.target.X,p.Y,a.target.Z)-p
            if delta.Magnitude&lt;5 then
                choosePedTarget(a)
            else
                local dir=delta.Unit
                local np=p+dir*a.speed*0.1
                a.model:PivotTo(CFrame.lookAt(np,np+dir))
            end
        end
    end

    signalTick+=dt
    if signalTick&gt;=1 then
        signalTick=0
        local cycle=math.floor((clock%30)/10)
        for _,m in ipairs(trafficLights) do
            local r=m:FindFirstChild("Red",true)
            local y=m:FindFirstChild("Yellow",true)
            local g=m:FindFirstChild("Green",true)
            if r and r:IsA("BasePart") then r.Transparency=(cycle==0 and 0 or .65) end
            if y and y:IsA("BasePart") then y.Transparency=(cycle==1 and 0 or .65) end
            if g and g:IsA("BasePart") then g.Transparency=(cycle==2 and 0 or .65) end
        end
    end

    fountainTick+=dt
    if fountainTick&gt;=0.5 then
        fountainTick=0
        for _,p in ipairs(fountainParts) do
            p.CFrame=p.CFrame*CFrame.Angles(0,math.rad(8),0)
        end
    end
end)

Players.PlayerAdded:Connect(function(plr)
    plr:SetAttribute("CityResident",true)
end)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXV8FOLDER"><Properties><string name="Name">CityV8Systems</string></Properties><Item class="StringValue" referent="RBXV8INFO"><Properties><string name="Name">Features</string><string name="Value">Random garage spawns; living day/night; weather; street lights; shop open/close; traffic signals; park ambience; night quiet event</string></Properties></Item><Item class="Folder" referent="RBXTRAFFIC_REQUESTED_9095"><Properties><string name="Name">Traffic</string></Properties></Item></Item><Item class="Script" referent="RBX6373c5a504db"><Properties><string name="Name">MergedLobbyServer</string><ProtectedString name="Source">-- 99 nights in the city
-- V8 temporary merged lobby
-- A lobby jelenleg ugyanabban a Place-ben van, mint a város.

local Players = game:GetService("Players")
local lobby = workspace:WaitForChild("TemporaryLobby")

local MAX_PLAYERS = 10
local COUNTDOWN = 12
local queues = {}

for i = 1, 5 do
    queues[i] = {players = {}, running = false}
end

local function removeFromQueues(player)
    for i = 1, 5 do
        local q = queues[i]
        for n = #q.players, 1, -1 do
            if q.players[n] == player then
                table.remove(q.players, n)
            end
        end
    end
end

local function cleanQueue(q)
    for n = #q.players, 1, -1 do
        if not q.players[n] or not q.players[n].Parent then
            table.remove(q.players, n)
        end
    end
end

local function setStatus(player, text)
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local label = gui and gui:FindFirstChild("MergedLobbyStatus")
    if label and label:IsA("TextLabel") then
        label.Text = text
    end
end

local function launch(index)
    local q = queues[index]
    if q.running then return end
    q.running = true

    for t = COUNTDOWN, 1, -1 do
        cleanQueue(q)
        if #q.players == 0 then break end

        for _, player in ipairs(q.players) do
            setStatus(
                player,
                ("Truck %d • departure in %ds • %d/%d"):format(
                    index, t, #q.players, MAX_PLAYERS
                )
            )
        end

        task.wait(1)
    end

    cleanQueue(q)

    -- Merged mode: nincs Place-teleport.
    -- A csapat egyszerűen elhagyja a lobbyterületet és elkezdi a városi futamot.
    for _, player in ipairs(q.players) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")

        if rootPart then
            local angle = math.random() * math.pi * 2
            local radius = 8 + math.random() * 10
            rootPart.CFrame = CFrame.new(
                math.cos(angle) * radius,
                5,
                math.sin(angle) * radius
            )
        end

        setStatus(player, "City run started")
        task.delay(3, function()
            local gui = player:FindFirstChildOfClass("PlayerGui")
            local label = gui and gui:FindFirstChild("MergedLobbyStatus")
            if label then
                label:Destroy()
            end
        end)
    end

    q.players = {}
    q.running = false
end

local function join(player, index)
    removeFromQueues(player)

    local q = queues[index]
    cleanQueue(q)

    if #q.players &gt;= MAX_PLAYERS then return end
    table.insert(q.players, player)

    local gui = player:FindFirstChildOfClass("PlayerGui")
    if gui then
        local old = gui:FindFirstChild("MergedLobbyStatus")
        if old then old:Destroy() end

        local label = Instance.new("TextLabel")
        label.Name = "MergedLobbyStatus"
        label.Size = UDim2.new(0, 420, 0, 55)
        label.Position = UDim2.new(0.5, -210, 0, 35)
        label.BackgroundTransparency = 0.2
        label.TextScaled = true
        label.Text = ("Truck %d • preparing departure..."):format(index)
        label.Parent = gui
    end

    if not q.running then
        task.spawn(function()
            launch(index)
        end)
    end
end

for _, prompt in ipairs(lobby:GetDescendants()) do
    if prompt:IsA("ProximityPrompt") and prompt.Name == "EnterTruck" then
        local bay = prompt:FindFirstAncestor("TruckBay")
        local index = bay and tonumber(bay.Name:match("TruckBay(%d+)"))

        if index then
            prompt.Triggered:Connect(function(player)
                join(player, index)
            end)
        end
    end
end

Players.PlayerRemoving:Connect(removeFromQueues)
</ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="Script" referent="RBXNEW_GAME_CONTROLLER_900001"><Properties><string name="Name">CityGameController</string><ProtectedString name="Source">
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local city = workspace:WaitForChild("City")
local safeBase = workspace:FindFirstChild("SafeBase")
local carsFolder = workspace:FindFirstChild("Vehicles")
local garages = workspace:FindFirstChild("HiddenGarages")
local lobby = workspace:FindFirstChild("TemporaryLobby")

local DAY_LENGTH = 150
local NIGHT_LENGTH = 150
local QUEUE_TIME = 12
local MAX_PER_TRUCK = 10
local CAR_COUNT = 4

local stateFolder = ReplicatedStorage:FindFirstChild("CityGameState") or Instance.new("Folder")
stateFolder.Name = "CityGameState"
stateFolder.Parent = ReplicatedStorage

local function value(className,name,default)
    local v = stateFolder:FindFirstChild(name)
    if not v then
        v = Instance.new(className); v.Name=name; v.Value=default; v.Parent=stateFolder
    end
    return v
end
local phase = value("StringValue","Phase","LOBBY")
local weather = value("StringValue","Weather","Clear")
local night = value("IntValue","Night",0)
local seconds = value("IntValue","Seconds",0)
local found = value("IntValue","CarsFound",0)
local started = value("BoolValue","Started",false)
local escaped = value("BoolValue","Escaped",false)
local objective = value("StringValue","Objective","Join a truck to begin")

local event = ReplicatedStorage:FindFirstChild("CityGameEvent") or Instance.new("RemoteEvent")
event.Name="CityGameEvent"; event.Parent=ReplicatedStorage

local queues = {}
local inQueue = {}
local startedPlayers = {}
local foundByPlayer = {}

local function getRoot(plr)
    local c=plr.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function modelPos(m)
    if not m then return nil end
    local ok,cf=pcall(function() return m:GetPivot() end)
    return ok and cf.Position or nil
end

local function moveTo(plr, pos)
    local r=getRoot(plr)
    if r then
        r.CFrame=CFrame.new(pos+Vector3.new(0,4,0))
    end
end

local function cityStart()
    local sp=workspace:FindFirstChild("CitySpawn",true)
    if sp and sp:IsA("SpawnLocation") then return sp.Position end
    if safeBase then
        local p=safeBase:FindFirstChild("TentEntrance")
        if p and p:IsA("BasePart") then return p.Position + Vector3.new(0,0,35) end
    end
    return Vector3.new(-1180,4,-1070)
end

local function lobbyStart()
    local sp=workspace:FindFirstChild("LobbySpawn",true)
    if sp and sp:IsA("SpawnLocation") then return sp.Position end
    return Vector3.new(-1200,4,1260)
end

local function notify(plr,title,text)
    event:FireClient(plr,"Notify",title,text)
end

local function setObjective(text)
    objective.Value=text
end

local function setupPlayer(plr)
    plr:SetAttribute("InCityRun",false)
    plr:SetAttribute("CarsFound",0)
    plr:SetAttribute("Hunger",100)
    plr:SetAttribute("Money",100)
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.15)
        if plr:GetAttribute("InCityRun") then moveTo(plr,cityStart()) else moveTo(plr,lobbyStart()) end
    end)
    if plr.Character then task.defer(function()
        if plr:GetAttribute("InCityRun") then moveTo(plr,cityStart()) else moveTo(plr,lobbyStart()) end
    end) end
end

Players.PlayerAdded:Connect(setupPlayer)
for _,p in ipairs(Players:GetPlayers()) do setupPlayer(p) end

local function queueBay(i)
    if not lobby then return nil end
    local bay = lobby:FindFirstChild("TruckBay"..i,true)
    if not bay then
        local five=lobby:FindFirstChild("FiveTruckLobby",true)
        if five then bay=five:FindFirstChild("TruckBay"..i,true) end
    end
    return bay
end

local function queueMessage(i)
    local q=queues[i]
    if not q then return end
    local bay=queueBay(i)
    if not bay then return end
    local prompt=bay:FindFirstChild("EnterTruck",true)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    if q.countdown then
        prompt.ActionText = "Indulás "..math.max(0,math.ceil(q.ends-os.clock())).."s"
    else
        prompt.ActionText = "Beszállás ("..#q.players.."/"..MAX_PER_TRUCK..")"
    end
end

local function leaveQueue(plr)
    local i=inQueue[plr]
    if not i then return end
    local q=queues[i]
    if q then
        for n,p in ipairs(q.players) do
            if p==plr then table.remove(q.players,n); break end
        end
        q.countdown=false; q.ends=0
    end
    inQueue[plr]=nil
end

local function startRun(i)
    local q=queues[i]
    if not q then return end
    local members=table.clone(q.players)
    queues[i]={players={},countdown=false,ends=0}
    for n,p in ipairs(members) do
        if p and p.Parent==Players then
            inQueue[p]=nil
            startedPlayers[p]=true
            p:SetAttribute("InCityRun",true)
            p:SetAttribute("CarsFound",0)
            p:SetAttribute("Hunger",100)
            p:SetAttribute("Money",100)
            moveTo(p,cityStart()+Vector3.new((n-1)%5*5-10,0,math.floor((n-1)/5)*5))
            notify(p,"🌆 CITY RUN","Find the 4 hidden sports cars, then return to the safe base.")
        end
    end
    if not started.Value then
        started.Value=true
        escaped.Value=false
        night.Value=1
        phase.Value="DAY"
        seconds.Value=0
        weather.Value="Clear"
        found.Value=0
        setObjective("Find the 4 hidden sports cars")
    end
end

for i=1,5 do
    queues[i]={players={},countdown=false,ends=0}
    local bay=queueBay(i)
    if bay then
        local prompt=bay:FindFirstChild("EnterTruck",true)
        if not prompt then
            local truck=bay:FindFirstChild("Truck",true)
            local host=truck and truck:FindFirstChildWhichIsA("BasePart",true)
            if host then
                prompt=Instance.new("ProximityPrompt"); prompt.Name="EnterTruck"; prompt.Parent=host
            end
        end
        if prompt then
            prompt.ActionText="Beszállás (0/"..MAX_PER_TRUCK..")"
            prompt.ObjectText="BLACK TRUCK"
            prompt.HoldDuration=0.25
            prompt.MaxActivationDistance=12
            prompt.Triggered:Connect(function(plr)
                if started.Value and plr:GetAttribute("InCityRun") then
                    notify(plr,"Már játékban vagy","A jelenlegi futam véget érhet, mielőtt újra beszállsz.")
                    return
                end
                if inQueue[plr] then leaveQueue(plr) end
                local q=queues[i]
                if #q.players&gt;=MAX_PER_TRUCK then
                    notify(plr,"FULL TRUCK","Ez a truck megtelt. Válassz egy másikat.")
                    return
                end
                table.insert(q.players,plr); inQueue[plr]=i
                if not q.countdown then q.countdown=true; q.ends=os.clock()+QUEUE_TIME end
                notify(plr,"🚚 BESZÁLLTÁL","Indulás rövidesen...")
            end)
        end
    end
end

local function addCarPrompt(car,index)
    if not car then return end
    local host=car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart",true)
    if not host then return end
    local prompt=host:FindFirstChild("SecureCarPrompt") or Instance.new("ProximityPrompt")
    prompt.Name="SecureCarPrompt"; prompt.ActionText="Autó biztosítása"; prompt.ObjectText="Rejtett sportautó #"..index
    prompt.HoldDuration=1; prompt.MaxActivationDistance=12; prompt.RequiresLineOfSight=false; prompt.Parent=host
    prompt.Triggered:Connect(function(plr)
        if not plr:GetAttribute("InCityRun") or foundByPlayer[plr] and foundByPlayer[plr][index] then return end
        foundByPlayer[plr]=foundByPlayer[plr] or {}
        if foundByPlayer[plr][index] then return end
        foundByPlayer[plr][index]=true
        local n=(plr:GetAttribute("CarsFound") or 0)+1
        plr:SetAttribute("CarsFound",n)
        found.Value=math.max(found.Value,n)
        notify(plr,"🚗 SPORTCAR FOUND!",n.." / "..CAR_COUNT.." found")
        if n&gt;=CAR_COUNT then
            notify(plr,"🏁 MIND A 4 MEGVAN!","Most juss vissza a város szélére és menekülj el.")
        end
    end)
end

if carsFolder then
    for i=1,CAR_COUNT do
        local car=carsFolder:FindFirstChild("SportsCar_"..i)
        addCarPrompt(car,i)
    end
end

local escapePart=workspace:FindFirstChild("CityEscapeZone")
if not escapePart then
    escapePart=Instance.new("Part"); escapePart.Name="CityEscapeZone"; escapePart.Size=Vector3.new(34,8,34)
    escapePart.Anchored=true; escapePart.CanCollide=false; escapePart.Transparency=1
    escapePart.Position=cityStart()+Vector3.new(0,0,55); escapePart.Parent=workspace
end
local ep=escapePart:FindFirstChild("EscapePrompt") or Instance.new("ProximityPrompt")
ep.Name="EscapePrompt"; ep.ActionText="MENEKÜLÉS"; ep.ObjectText="Város széle"; ep.HoldDuration=2; ep.MaxActivationDistance=14; ep.Parent=escapePart
ep.Triggered:Connect(function(plr)
    if not plr:GetAttribute("InCityRun") then return end
    if (plr:GetAttribute("CarsFound") or 0)&lt;CAR_COUNT then
        notify(plr,"MÉG NEM!","Még "..(CAR_COUNT-(plr:GetAttribute("CarsFound") or 0)).." autót kell megtalálnod.")
        return
    end
    escaped.Value=true
    plr:SetAttribute("InCityRun",false)
    notify(plr,"🎉 SIKERES MENEKÜLÉS!","A futam teljesítve. Visszatérsz a lobbyba.")
    task.delay(2,function()
        if plr.Parent==Players then plr:LoadCharacter() end
    end)
end)

local function chooseWeather()
    local list={"Clear","Fog","Rain","Storm"}
    return list[math.random(1,#list)]
end

local function applyLighting()
    if phase.Value=="DAY" then
        Lighting.ClockTime=13
        Lighting.Brightness=2.2
        Lighting.FogEnd=1000
    else
        Lighting.ClockTime=1.5
        Lighting.Brightness=0.55
        Lighting.FogEnd=(weather.Value=="Fog" and 180 or 650)
    end
    if weather.Value=="Storm" and phase.Value=="NIGHT" and math.random()&lt;0.035 then
        Lighting.Brightness=4
        task.delay(0.08,function() if phase.Value=="NIGHT" then Lighting.Brightness=0.35 end end)
    end
end

task.spawn(function()
    while true do
        for i,q in pairs(queues) do
            if q.countdown and os.clock()&gt;=q.ends then startRun(i) end
            queueMessage(i)
        end
        task.wait(0.25)
    end
end)

task.spawn(function()
    while true do
        if started.Value and not escaped.Value then
            seconds.Value += 1
            if phase.Value=="DAY" then
                if seconds.Value&gt;=DAY_LENGTH then
                    phase.Value="NIGHT"; seconds.Value=0; weather.Value=chooseWeather()
                    setObjective("Survive the night • Find the cars")
                    for _,p in ipairs(Players:GetPlayers()) do
                        if p:GetAttribute("InCityRun") then notify(p,"🌙 ÉJSZAKA","A város megváltozik. Maradj éber.") end
                    end
                end
            else
                if seconds.Value&gt;=NIGHT_LENGTH then
                    night.Value+=1; phase.Value="DAY"; seconds.Value=0; weather.Value="Clear"
                    setObjective((found.Value&gt;=CAR_COUNT) and "Return to the safe base" or "Find the 4 hidden sports cars")
                    for _,p in ipairs(Players:GetPlayers()) do
                        if p:GetAttribute("InCityRun") then notify(p,"☀️ HAJNAL","Night "..(night.Value-1).." complete.") end
                    end
                end
            end
            applyLighting()
            for _,p in ipairs(Players:GetPlayers()) do
                if p:GetAttribute("InCityRun") then
                    local h=(p:GetAttribute("Hunger") or 100)-1/30
                    if h&lt;0 then h=0 end
                    p:SetAttribute("Hunger",h)
                    if h&lt;=0 then
                        local c=p.Character; local hum=c and c:FindFirstChildOfClass("Humanoid")
                        if hum then hum:TakeDamage(2) end
                    end
                end
            end
        else
            phase.Value="LOBBY"; seconds.Value=0
        end
        task.wait(1)
    end
end)
</ProtectedString><bool name="Disabled">false</bool><token name="RunContext">0</token></Properties></Item><Item class="Script" referent="RBXPAID_SERVER"><Properties><string name="Name">PaidContentServer</string><ProtectedString name="Source">local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local paid = ReplicatedStorage:WaitForChild("PaidContent")
local catalog = paid:WaitForChild("Catalog")

-- Put the real Roblox Developer Product / Game Pass IDs into these entries
-- after creating them in the Creator Dashboard. PriceRobux is informational.
local PRODUCTS = {
    HP100 = 0,
    EquipmentPack3 = 0,
    Cash100 = 0,
    Cash500 = 0,
    Cash1000 = 0,
}

local PASSES = {
    SlowerHunger = 0,
    PremiumSportsCar = 0,
}

local function grantProduct(player, productId)
    if productId == PRODUCTS.HP100 then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        local currentMax = player:GetAttribute("BaseMaxHealth") or 100
        currentMax += 100
        player:SetAttribute("BaseMaxHealth", currentMax)
        if hum then
            hum.MaxHealth = currentMax
            hum.Health = math.min(hum.Health + 100, hum.MaxHealth)
        end
        return true

    elseif productId == PRODUCTS.EquipmentPack3 then
        -- Marks the in-game equipment entitlement. The existing game can consume
        -- this entitlement without exposing any real-world item.
        player:SetAttribute("EquipmentPack3Owned", true)
        return true

    elseif productId == PRODUCTS.Cash100 then
        player:SetAttribute("Money", (player:GetAttribute("Money") or 0) + 100)
        return true

    elseif productId == PRODUCTS.Cash500 then
        player:SetAttribute("Money", (player:GetAttribute("Money") or 0) + 500)
        return true

    elseif productId == PRODUCTS.Cash1000 then
        player:SetAttribute("Money", (player:GetAttribute("Money") or 0) + 1000)
        return true
    end

    return false
end

MarketplaceService.ProcessReceipt = function(receiptInfo)
    local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
    if not player then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    if grantProduct(player, receiptInfo.ProductId) then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end

    return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function applyPasses(player)
    for passName, passId in pairs(PASSES) do
        if passId ~= 0 then
            local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync,
                MarketplaceService, player.UserId, passId)
            if ok and owns then
                if passName == "SlowerHunger" then
                    player:SetAttribute("SlowerHunger", true)
                elseif passName == "PremiumSportsCar" then
                    player:SetAttribute("PremiumSportsCar", true)
                end
            end
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    player:SetAttribute("BaseMaxHealth", player:GetAttribute("BaseMaxHealth") or 100)
    player:SetAttribute("SlowerHunger", false)
    player:SetAttribute("PremiumSportsCar", false)
    player:SetAttribute("EquipmentPack3Owned", false)
    task.spawn(applyPasses, player)

    player.CharacterAdded:Connect(function(character)
        local hum = character:WaitForChild("Humanoid", 5)
        if hum then
            hum.MaxHealth = player:GetAttribute("BaseMaxHealth") or 100
            hum.Health = math.min(hum.Health, hum.MaxHealth)
        end
    end)
end)
