local P=game:GetService("Players").LocalPlayer
local RS=game:GetService("ReplicatedStorage")
local S=RS:WaitForChild("GameState")
local gui=Instance.new("ScreenGui"); gui.Name="CityHUD"; gui.ResetOnSpawn=false; gui.Parent=P:WaitForChild("PlayerGui")
local f=Instance.new("Frame"); f.Size=UDim2.new(.84,0,.18,0); f.Position=UDim2.new(.08,0,.04,0); f.BackgroundTransparency=.2; f.Parent=gui
local title=Instance.new("TextLabel"); title.Size=UDim2.new(1,0,.32,0); title.BackgroundTransparency=1; title.TextScaled=true; title.Font=Enum.Font.GothamBold; title.TextColor3=Color3.new(1,1,1); title.Text="99 nights in the city"; title.Parent=f
local status=title:Clone(); status.Position=UDim2.new(0,0,.32,0); status.Size=UDim2.new(1,0,.28,0); status.Text="DAY"; status.Parent=f
local stats=title:Clone(); stats.Position=UDim2.new(0,0,.60,0); stats.Size=UDim2.new(1,0,.40,0); stats.Font=Enum.Font.Gotham; stats.Parent=f
local function update()
    local c=P.Character; local h=c and c:FindFirstChildOfClass("Humanoid")
    status.Text=(S.IsNight.Value==1 and "NIGHT" or "DAY").."  •  "..S.SecondsLeft.Value.."s"
    stats.Text="♥ "..math.floor(h and h.Health or 0).."   🍗 "..(P:GetAttribute("Hunger") or 0).."   $"..(P:GetAttribute("Money") or 0).."   🚗 "..S.CarsRecovered.Value.."/4"
end
S.IsNight.Changed:Connect(update); S.SecondsLeft.Changed:Connect(update); S.CarsRecovered.Changed:Connect(update)
P:GetAttributeChangedSignal("Hunger"):Connect(update); P:GetAttributeChangedSignal("Money"):Connect(update)
P.CharacterAdded:Connect(function(c) c:WaitForChild("Humanoid").HealthChanged:Connect(update); update() end)
update()
