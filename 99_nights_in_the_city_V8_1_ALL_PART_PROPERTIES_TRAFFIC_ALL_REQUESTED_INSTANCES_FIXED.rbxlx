    <Item class="Script" referent="RBX00004154">
      <Properties>
        <string name="Name">ShopService</string><bool name="Disabled">true</bool>
        <ProtectedString name="Source">
local prices={FoodMarket=20,Pharmacy=40,CarDealer=150,Mechanic=60,HardwareStore=25,Supermarket=30}
for _,shop in ipairs(workspace.City.Shops:GetChildren()) do
    local base=shop.Store
    local prompt=Instance.new("ProximityPrompt")
    prompt.ActionText="Search"; prompt.ObjectText=shop.Name; prompt.HoldDuration=.6; prompt.MaxActivationDistance=10
    prompt.Parent=base
    prompt.Triggered:Connect(function(p)
        local money=p:GetAttribute("Money") or 0; local cost=prices[shop.Name] or 20
        if money&lt;cost then return end
        p:SetAttribute("Money",money-cost)
        if shop.Name=="FoodMarket" or shop.Name=="Supermarket" then
            p:SetAttribute("Hunger",math.min(100,(p:GetAttribute("Hunger") or 0)+35))
        elseif shop.Name=="Pharmacy" then
            local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if h then h.Health=math.min(h.MaxHealth,h.Health+35) end
        end
    end)
end
