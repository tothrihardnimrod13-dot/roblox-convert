 name="Value">3-piece in-game equipment pack</string></Properties></Item><Item class="Folder" referent="RBXTRAFFIC_REQUESTED_9059"><Properties><string name="Name">Traffic</string></Properties></Item></Item><Item class="Folder" referent="RBXPAID_SlowerHunger"><Properties><string name="Name">SlowerHunger</string></Properties><Item class="StringValue" referent="RBXPAID_ProductType1871737502729105491_FIX2"><Properties><string name="Name">ProductType</string><string name="Value">GamePass</string></Properties></Item><Item class="IntValue" referent="RBXPAID_PriceRobux7427142257213845270_FIX2"><Properties><string name="Name">PriceRobux</string><int name="Value">150</int></Properties></Item><Item class="IntValue" referent="RBXPAID_ProductId2922444414237037373_FIX2"><Properties><string name="Name">ProductId</string><int name="Value">0</int></Properties></Item><Item class="StringValue" referent="RBXPAID_Description3246364677779695526_FIX2"><Properties><string name="Name">Description</string><string name="Value">Reduce hunger drain</string></Properties></Item><Item class="Folder" referent="RBXTRAFFIC_REQUESTED_9064"><Properties><string name="Name">Traffic</string></Properties></Item></Item><Item class="Folder" referent="RBXPAID_PremiumSportsCar"><Properties><string name="Name">PremiumSportsCar</string></Properties><Item class="StringValue" referent="RBXPAID_ProductType1871737502729105491_FIX3"><Properties><string name="Name">ProductType</string><string name="Value">GamePass</string></Properties></Item><Item class="IntValue" referent="RBXPAID_PriceRobux7427142257213845270_FIX3"><Properties><string name="Name">PriceRobux</string><int name="Value">600</int></Properties></Item><Item class="IntValue" referent="RBXPAID_ProductId2922444414237037373_FIX3"><Properties><string name="Name">ProductId</string><int name="Value">0</int></Properties></Item><Item class="StringValue" referent="RBXPAID_Description3246364677779695526_FIX3"><Properties><string name="Name">Description</string><strin